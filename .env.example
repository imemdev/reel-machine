# Backend paths are relative to this project unless absolute.
DATABASE_PATH=data/library.db
ARTIFACT_ROOT=data/runs
ALLOW_FIXTURE_SOURCES=false
API_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
# Where your organized copies go: Videos/<Platform>/... and Audio/<Platform>/...
# Defaults to ~/Documents/Reel Machine. Windows example: C:/Users/you/Documents/Reel Machine
MEDIA_ROOT=
# YouTube, Instagram, and Facebook download the full video with yt-dlp (from
# the project's Python environment; this is only a fallback command name).
YTDLP=yt-dlp
# Legacy audio-only wrapper, no longer used for new downloads.
YTA_FUNCTION=./scripts/yta
# TikTok: gallery-dl downloads the public video locally, then FFmpeg extracts
# the audio. Install the downloads extra explicitly first.
GALLERY_DL=gallery-dl
FFMPEG=ffmpeg
# FarukSTT is loaded through local Transformers from this model id or a local
# directory. Install the optional FarukSTT dependencies before processing.
# macOS/Linux example: ${HOME}/models/FarukSTT
# Windows example (use forward slashes): C:/Users/you/models/FarukSTT
FARUKSTT_MODEL=${HOME}/Library/Caches/kite/FarukSTT
# Optional context from an earlier installation; leave blank if unavailable.
PIPELINE_PROMPT_FILE=
PIPELINE_LEDGER_FILE=
# Model downloads are explicit setup steps, never part of a processing run.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
WORKER_POLL_SECONDS=0.5
MAX_BATCH_SIZE=12
