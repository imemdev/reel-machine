# Backend paths are relative to this project unless absolute.
DATABASE_PATH=data/library.db
ARTIFACT_ROOT=data/runs
ALLOW_FIXTURE_SOURCES=false
API_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
YTDLP=yt-dlp
# URL downloads go through this login-shell function. The default yta preserves
# the local youtube-downloader web_embedded extractor and embedding options.
YTA_FUNCTION=yta
# TikTok-only fallback: gallery-dl downloads the public video locally, then
# FFmpeg extracts the audio. If gallery-dl is not installed, the worker can use
# the cached uvx package runner when available.
GALLERY_DL=gallery-dl
FFMPEG=ffmpeg
WHISPER_CLI=whisper-cli
# Full Whisper Large-v3 only. A quantized/turbo file is intentionally not used
# for this selectable option.
WHISPER_LARGE_V3_MODEL=/Users/a/Library/Caches/whisper.cpp/ggml-large-v3.bin
# FarukSTT is loaded through local Transformers from this model id or a local
# directory. Install the optional FarukSTT dependencies before selecting it.
FARUKSTT_MODEL=medyas/FarukSTT
PIPELINE_PROMPT_FILE=/Users/a/Documents/reels/transcription_pipeline/context/tunisian_mixed_script_prompt.txt
PIPELINE_LEDGER_FILE=/Users/a/Documents/reels/transcription_pipeline/context/candidate_edit_ledger.json
WORKER_POLL_SECONDS=0.5
MAX_BATCH_SIZE=12
